#!/usr/bin/env bash
# SuperCtx discovery hook.
# Runs at SessionStart. Read-only: this never writes anything.

set -euo pipefail

# Safely check if CLAUDE_PLUGIN_ROOT is set
if [[ -z "${CLAUDE_PLUGIN_ROOT:-}" ]]; then
  exit 0
fi

# Run read-only internal detection, silencing stderr.
state_json=$(PYTHONPATH="${CLAUDE_PLUGIN_ROOT}/scripts" python3 -m superctx._detect 2>/dev/null || true)

if [[ -n "$state_json" ]]; then
  # Parse state, recommended_action, and candidates safely using python
  read -r state action candidates_csv <<<$(printf '%s' "$state_json" | python3 -c '
import json, sys
d = json.load(sys.stdin)
state = d.get("state", "not_candidate")
action = d.get("recommended_action", "none")
candidates = d.get("candidates", [])
print(state, action, ",".join(candidates))
' 2>/dev/null || true)

  if [[ "$state" == "managed_healthy" ]]; then
    if [[ -n "${candidates_csv:-}" ]]; then
      candidate_list=$(printf '%s' "$candidates_csv" | python3 -c '
import sys
paths = sys.stdin.read().strip().split(",")
print("\n".join("- " + p for p in paths if p))
' 2>/dev/null || true)
      printf 'SuperCtx is active, but there are unconnected instruction files:\n%s\n\nOffer to connect these files to the shared context hub (with explicit consent). After the user confirms, run the add command internally (using `/superctx:add <path>`).\n' "$candidate_list"
    else
      cat <<'EOF'
SuperCtx is active. `.ctx/SUPERCTX.md` is the canonical shared project context. Registered tool instruction files are generated shims pointing to it.
EOF
    fi
  elif [[ "$state" == "managed_needs_repair" ]]; then
    if [[ "$action" == "repair" ]]; then
      # Tool configuration an earlier version replaced with a pointer is not shim damage,
      # and sync does not restore it: name it and give the manual recovery steps.
      adopted_list=$(printf '%s' "$state_json" | python3 -c '
import json, sys
print("\n".join("- " + p for p in json.load(sys.stdin).get("adopted_tool_config", [])))
' 2>/dev/null || true)
      other_findings=$(printf '%s' "$state_json" | python3 -c '
import json, sys
reasons = set(json.load(sys.stdin).get("reasons", []))
print("yes" if reasons - {"tool_config_adopted", "untracked_candidates_found"} else "no")
' 2>/dev/null || true)
      recovery='for each path, copy the original back from `.ctx/sources/<path>`, delete its `[[natives]]` entry from `.ctx/superctx.toml`, and delete its `## From: <path>` section from `.ctx/SUPERCTX.md`'
      if [[ -n "$adopted_list" && "$other_findings" == "no" ]]; then
        printf 'SuperCtx is active. `.ctx/SUPERCTX.md` is the canonical shared project context, and the registered instruction files are intact. An earlier SuperCtx version replaced this tool configuration with a pointer:\n%s\n\nSuperCtx does not restore it automatically. Tell the user, and offer to walk through the recovery: %s. Change nothing without explicit consent.\n' "$adopted_list" "$recovery"
      else
        cat <<'EOF'
SuperCtx is active, but the installation has broken or missing shims. Inspect the setup and offer to repair the shims. Once the user gives consent, run the repair internally (using `/superctx:sync`).
EOF
        if [[ -n "$adopted_list" ]]; then
          printf '\nSeparately, an earlier SuperCtx version replaced this tool configuration with a pointer:\n%s\n\nThe repair will not restore it. Offer to walk through the recovery: %s. Change nothing without explicit consent.\n' "$adopted_list" "$recovery"
        fi
      fi
    elif [[ "$action" == "migrate" ]]; then
      cat <<'EOF'
SuperCtx is present, but an upgrade of its manifest to `.ctx/superctx.toml` was interrupted. Offer to resume it. Once the user gives consent, run it internally (using `/superctx:sync`).
EOF
    else
      cat <<'EOF'
SuperCtx is present, but the configuration manifest is missing or invalid. Explain the problem and offer to inspect the setup.
EOF
    fi
  elif [[ "$state" == "managed_legacy" ]]; then
    cat <<'EOF'
SuperCtx is present, but some instruction files are legacy and not yet fully migrated. Explain this situation to the user, preserve existing instruction contents, and offer to migrate the legacy setup after obtaining explicit consent.
EOF
  elif [[ "$state" == "candidate_repo" && -n "${candidates_csv:-}" ]]; then
    # Format candidate file list for the agent
    candidate_list=$(printf '%s' "$candidates_csv" | python3 -c '
import sys
paths = sys.stdin.read().strip().split(",")
print("\n".join("- " + p for p in paths if p))
' 2>/dev/null || true)
    printf 'SuperCtx setup opportunity: This repository has agent instruction files but no shared context hub.\n\nDetected files:\n%s\n\nOffer to set up one shared context hub. Explain that this will:\n- create `.ctx/SUPERCTX.md` as the canonical project context\n- back up the originals under `.ctx/sources/`\n- replace the live instruction files with generated shims pointing to the hub\n\nAsk for explicit consent before doing anything. After the user confirms, perform setup internally (using `/superctx:sync`) without asking them to type a command.\n' "$candidate_list"
  elif [[ "$state" == "candidate_repo" ]]; then
    echo "SuperCtx is not set up in this repository, and none of its instruction files can be adopted."
  fi

  # Files holding SuperCtx pointer text cannot be adopted: explain them, never offer them.
  left_list=$(printf '%s' "$state_json" | python3 -c '
import json, sys
left = json.load(sys.stdin).get("left_in_place", [])
print("\n".join("- {} ({})".format(i["path"], i["reason"]) for i in left))
' 2>/dev/null || true)
  if [[ -n "$left_list" ]]; then
    printf '\nSuperCtx left these files in place because they hold SuperCtx pointer text, so it cannot tell what they held before or whether a backup of that exists:\n%s\n\nDo not offer to connect them or to set SuperCtx up for them. If the user asks, explain why, and change nothing without explicit consent.\n' "$left_list"
  fi
fi
